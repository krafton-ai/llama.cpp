#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require

// ggml_mla_expand_kv: per-head K / V of an MLA head group from the F16 latent cache.
// MODE 0 (GEMM, one head per workgroup z): D[m, t] = sum_r A(m, r) * latent(r, t), F32 accumulation, one F16 rounding;
//   A(m, r) = w[w_off + h*a_sh + m*a_sm + r*a_sr] (F16 weights of the group: W_UK with a_sm = 1, or W_UV^T with a_sr = 1),
//   latent(r, t) = kv[kv_off + t*ldk + r], D[m, t] -> d[d_off + t*d_ld + h*d_sh + m]
// MODE 1 (the shared RoPE part into every head's K row): d[d_off + (t*g + h)*nk + nn + j] = kv[kv_off + t*ldk + rank + j]

layout(constant_id = 0) const uint MODE = 0;

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly  buffer W  { float16_t data_w[];  };
layout(binding = 1) readonly  buffer KV { float16_t data_kv[]; };
layout(binding = 2) writeonly buffer D  { float16_t data_d[];  };

layout(push_constant) uniform parameter {
    uint M; uint N; uint K;
    uint ldk;
    uint a_sm; uint a_sr; uint a_sh;
    uint d_ld; uint d_sh;
    uint w_off; uint kv_off; uint d_off;
    uint g; uint nr; uint nn; uint nk;
} p;

const uint TM = 64;
const uint TN = 64;
const uint TK = 16;

shared float As[TK][TM + 1];
shared float Bs[TK][TN + 1];

void main() {
    const uint tid = gl_LocalInvocationID.x;

    if (MODE == 1) {
        // N = n_kv, K = rank
        const uint i = gl_GlobalInvocationID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x * 256;
        if (i >= p.N * p.g * p.nr) {
            return;
        }
        const uint j  = i % p.nr;
        const uint th = i / p.nr;
        const uint t  = th / p.g;
        data_d[p.d_off + th * p.nk + p.nn + j] = data_kv[p.kv_off + t * p.ldk + p.K + j];
        return;
    }

    const uint m0 = gl_WorkGroupID.x * TM;
    const uint n0 = gl_WorkGroupID.y * TN;
    const uint h  = gl_WorkGroupID.z;
    const uint tx = tid % 16;   // token group of 4
    const uint ty = tid / 16;   // row group of 4
    const uint wb = p.w_off + h * p.a_sh;

    float acc[4][4];
    [[unroll]] for (uint i = 0; i < 4; ++i) {
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            acc[i][j] = 0.0f;
        }
    }

    for (uint k0 = 0; k0 < p.K; k0 += TK) {
        [[unroll]] for (uint l = 0; l < TK * TM / 256; ++l) {
            const uint idx = tid + l * 256;
            // along m when a_sm == 1 (W_UK), along r otherwise (W_UV^T): consecutive invocations read consecutive weights
            const uint kk = p.a_sm == 1 ? idx / TM : idx % TK;
            const uint mm = p.a_sm == 1 ? idx % TM : idx / TK;
            const uint m = m0 + mm, r = k0 + kk;
            As[kk][mm] = m < p.M && r < p.K ? float(data_w[wb + m * p.a_sm + r * p.a_sr]) : 0.0f;
        }
        [[unroll]] for (uint l = 0; l < TK * TN / 256; ++l) {
            const uint idx = tid + l * 256;
            const uint kk = idx % TK, nn_ = idx / TK;
            const uint t = n0 + nn_, r = k0 + kk;
            Bs[kk][nn_] = t < p.N && r < p.K ? float(data_kv[p.kv_off + t * p.ldk + r]) : 0.0f;
        }
        barrier();
        [[unroll]] for (uint kk = 0; kk < TK; ++kk) {
            float a[4], b[4];
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                a[i] = As[kk][ty * 4 + i];
                b[i] = Bs[kk][tx * 4 + i];
            }
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                [[unroll]] for (uint j = 0; j < 4; ++j) {
                    acc[i][j] = fma(a[i], b[j], acc[i][j]);
                }
            }
        }
        barrier();
    }

    [[unroll]] for (uint j = 0; j < 4; ++j) {
        const uint t = n0 + tx * 4 + j;
        if (t >= p.N) {
            continue;
        }
        [[unroll]] for (uint i = 0; i < 4; ++i) {
            const uint m = m0 + ty * 4 + i;
            if (m < p.M) {
                data_d[p.d_off + t * p.d_ld + h * p.d_sh + m] = float16_t(acc[i][j]);
            }
        }
    }
}
